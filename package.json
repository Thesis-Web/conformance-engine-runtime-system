{
  "name": "conformance-engine-runtime-system",
  "version": "0.1.0",
  "private": true,
  "description": "CERS deterministic engine-first runtime scaffold",
  "license": "UNLICENSED",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "build": "tsc -p tsconfig.json",
    "schema:validate": "npx tsx scripts/validate-schemas.ts",
    "artifact:validate": "npx tsx scripts/validate-artifacts.ts",
    "pack:validate": "npx tsx scripts/validate-packs.ts",
    "replay:smoke": "npx tsx scripts/replay-smoke.ts",
    "run:poc": "npx tsx scripts/run-poc.ts",
    "run:validate": "npx tsx scripts/run-validate.ts",
    "ci:gate": "npm run lint && npm run typecheck && npm run test && npm run test:integration && npm run schema:validate && npm run artifact:validate && npm run pack:validate && npm run replay:smoke"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pdf-parse": "^1.1.5",
    "prettier": "^3.5.3",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "zod": "^3.22.4"
  },
  "dependencies": {
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5"
  }
}
