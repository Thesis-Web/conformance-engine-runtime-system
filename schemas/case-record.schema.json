{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cers:case-record",
  "type": "object",
  "title": "CaseRecord",
  "required": ["caseId", "packId", "title", "createdAt", "createdBy", "actorMode", "sourceRoot"],
  "additionalProperties": false,
  "properties": {
    "caseId": {
      "type": "string"
    },
    "externalCaseRef": {
      "type": "string"
    },
    "packId": {
      "description": "Governed pack identifier. Accepts legacy California pack IDs and open governed pack IDs matching the canonical pattern (e.g. pack-us-tx-buildings-v1).",
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string"
    },
    "createdBy": {
      "type": "string",
      "minLength": 1
    },
    "actorMode": {
      "type": "string",
      "const": "human_interface_first"
    },
    "sourceRoot": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "trackFamilyId": {
      "type": "string"
    },
    "jurisdictionFamilyId": {
      "type": "string"
    },
    "jurisdictionId": {
      "type": "string"
    },
    "municipalityId": {
      "type": "string"
    },
    "tenantId": {
      "type": "string"
    },
    "orgId": {
      "type": "string"
    },
    "uploadedBy": {
      "type": "string",
      "minLength": 1
    },
    "governingAsOfDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
