{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cers:case-record",
  "type": "object",
  "title": "CaseRecord",
  "required": ["caseId", "packId", "title", "createdAt", "createdBy", "actorMode", "sourceRoot"],
  "additionalProperties": false,
  "properties": {
    "caseId": { "type": "string" },
    "externalCaseRef": { "type": "string" },
    "packId": {
      "type": "string",
      "enum": [
        "pack-california-highrise-v1",
        "pack-california-appliance-refrig-v2",
        "pack-california-datacenter-v3"
      ]
    },
    "title": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string" },
    "createdBy": { "type": "string", "minLength": 1 },
    "actorMode": { "type": "string", "const": "human_interface_first" },
    "sourceRoot": { "type": "string" },
    "notes": { "type": "string" }
  }
}
