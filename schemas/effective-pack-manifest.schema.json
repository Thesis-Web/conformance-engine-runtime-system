{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cers:effective-pack-manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packId",
    "versionIndex",
    "displayName",
    "jurisdiction",
    "corpus",
    "classMap",
    "hierarchyConfig",
    "contradictionPatterns",
    "optionalExtractors",
    "standardVersionPolicy",
    "supportedDocumentClasses",
    "effectivePackId",
    "effectivePackVersion",
    "trackFamilyId",
    "jurisdictionFamilyId",
    "jurisdictionId",
    "tierPath",
    "governingAsOfDate",
    "componentProvenance",
    "compositionDigest",
    "resolvedAt",
    "resolvedBy",
    "resolutionMethod",
    "replayPinned",
    "releaseState"
  ],
  "properties": {
    "packId": { "type": "string" },
    "versionIndex": { "type": "string" },
    "displayName": { "type": "string" },
    "jurisdiction": { "type": "string" },
    "corpus": { "type": "array" },
    "classMap": { "type": "array" },
    "hierarchyConfig": { "type": "array" },
    "contradictionPatterns": { "type": "array" },
    "optionalExtractors": { "type": "array" },
    "standardVersionPolicy": { "type": "object" },
    "supportedDocumentClasses": { "type": "array" },
    "effectivePackId": { "type": "string" },
    "effectivePackVersion": { "type": "string" },
    "trackFamilyId": { "type": "string" },
    "jurisdictionFamilyId": { "type": "string" },
    "jurisdictionId": { "type": "string" },
    "tierPath": { "type": "array" },
    "municipalityId": { "type": "string" },
    "governingAsOfDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "componentProvenance": { "type": "array" },
    "compositionDigest": { "type": "string" },
    "resolvedAt": { "type": "string" },
    "resolvedBy": { "type": "string" },
    "resolutionReason": { "type": "string" },
    "resolutionMethod": {
      "type": "string",
      "enum": ["composed_fresh", "reused_precomputed", "replayed_pinned"]
    },
    "replayPinned": { "type": "boolean" },
    "replaySourceRunId": { "type": "string" },
    "releaseState": {
      "type": "string",
      "enum": ["draft", "in_review", "released", "superseded"]
    },
    "reviewedBy": { "type": "string" },
    "releasedBy": { "type": "string" },
    "releasedAt": { "type": "string" },
    "reviewSignatureRef": { "type": "string" },
    "tenantId": { "type": "string" },
    "orgId": { "type": "string" }
  }
}
