{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cers:ask",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "askId",
    "runId",
    "linkedFindingId",
    "packId",
    "severity",
    "askType",
    "text",
    "requiredForCleanOutput"
  ],
  "properties": {
    "askId": { "type": "string" },
    "runId": { "type": "string" },
    "linkedFindingId": { "type": "string" },
    "packId": {
      "type": "string",
      "enum": [
        "pack-california-highrise-v1",
        "pack-california-appliance-refrig-v2",
        "pack-california-datacenter-v3"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "askType": {
      "type": "string",
      "enum": ["required_artifact", "clarification", "authority_check", "evidence_gap"]
    },
    "text": { "type": "string" },
    "requiredForCleanOutput": { "type": "boolean" }
  }
}
