{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cers:run-record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runId",
    "caseId",
    "packId",
    "status",
    "startedAt",
    "engineVersion",
    "blueprintVersion",
    "specVersion",
    "operatorMode",
    "artifactRoot"
  ],
  "properties": {
    "runId": {
      "type": "string"
    },
    "caseId": {
      "type": "string"
    },
    "packId": {
      "type": "string",
      "enum": [
        "pack-california-highrise-v1",
        "pack-california-appliance-refrig-v2",
        "pack-california-datacenter-v3"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "ingesting",
        "ingested",
        "classified",
        "compare_pairs_built",
        "pass1_complete",
        "pass2_complete",
        "rules_complete",
        "artifacts_built",
        "validated",
        "complete",
        "failed"
      ]
    },
    "startedAt": {
      "type": "string"
    },
    "completedAt": {
      "type": "string"
    },
    "engineVersion": {
      "type": "string"
    },
    "blueprintVersion": {
      "type": "string"
    },
    "specVersion": {
      "type": "string"
    },
    "operatorMode": {
      "const": "manual_prompt_bridge"
    },
    "artifactRoot": {
      "type": "string"
    },
    "failureReason": {
      "type": "string"
    },
    "resolvedEffectivePackId": {
      "type": "string"
    },
    "resolvedAt": {
      "type": "string"
    },
    "resolvedBy": {
      "type": "string"
    },
    "reviewedBy": {
      "type": "string"
    },
    "governingAsOfDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "releasedBy": {
      "type": "string"
    },
    "releasedAt": {
      "type": "string"
    },
    "reviewSignatureRef": {
      "type": "string"
    },
    "releaseState": {
      "type": "string",
      "enum": ["draft", "in_review", "released", "superseded"]
    },
    "replaySourceRunId": {
      "type": "string"
    },
    "compositionDigest": {
      "type": "string"
    },
    "componentDigests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tierPath": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tierType", "tierId"],
        "properties": {
          "tierType": {
            "type": "string",
            "enum": [
              "supranational",
              "national",
              "state_or_member_state",
              "regional",
              "municipal",
              "local_authority"
            ]
          },
          "tierId": {
            "type": "string"
          },
          "parentTierId": {
            "type": "string"
          }
        }
      }
    }
  }
}
