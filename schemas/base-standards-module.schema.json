{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "cers:base-standards-module",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseModuleId",
    "displayName",
    "supportedTrackFamilies",
    "corpus",
    "hierarchyFragments",
    "contradictionPatternFragments",
    "versionIndex",
    "effectiveFrom",
    "ownershipPackId",
    "provenance"
  ],
  "properties": {
    "baseModuleId": { "type": "string" },
    "displayName": { "type": "string", "minLength": 1 },
    "supportedTrackFamilies": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "corpus": { "type": "array" },
    "hierarchyFragments": { "type": "array" },
    "contradictionPatternFragments": { "type": "array" },
    "versionIndex": { "type": "string", "minLength": 1 },
    "effectiveFrom": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "effectiveTo": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "ownershipPackId": { "type": "string" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceOwner", "sourceAuthority", "lineageRef"],
      "properties": {
        "sourceOwner": { "type": "string", "minLength": 1 },
        "sourceAuthority": {
          "type": "string",
          "enum": ["primary", "secondary", "reference"]
        },
        "lineageRef": { "type": "string", "minLength": 1 },
        "authoringRef": { "type": "string" }
      }
    }
  }
}
